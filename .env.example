# Example environment variables for local development
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# رابط الإنتاج على Vercel (يُستخدم أيضاً في Capacitor لـ Google Play)
# مثال: https://dallouniapp.vercel.app
NEXT_PUBLIC_APP_URL=

# ===== لوحة التحكم /admin =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# اختياري: سر توقيع جلسة الأدمن (إن تُرك فارغاً يُشتق من البريد وكلمة المرور)
ADMIN_SESSION_SECRET=

# مفتاح service role من Supabase (Project Settings → API) — للخادم فقط، لا تعرضه للعميل
SUPABASE_SERVICE_ROLE_KEY=
